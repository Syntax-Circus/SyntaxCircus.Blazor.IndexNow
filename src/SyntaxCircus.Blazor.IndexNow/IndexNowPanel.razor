<section class="card mt-4" aria-labelledby="indexnow-heading">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 mb-0" id="indexnow-heading">@Title</h2>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="indexnow-toggle" aria-controls="indexnow-editor"
                    aria-expanded="@(_expanded ? "true" : "false")" @onclick="Toggle">
                @(_expanded ? "Hide IndexNow" : "Manage IndexNow")
            </button>
        </div>
        <div id="indexnow-editor">
            @if (_expanded)
            {
                <IndexNowEditor SuggestedCanonicalUrl="@SuggestedCanonicalUrl" />
            }
        </div>
    </div>
</section>
@code {
    /// <summary>Heading shown on the card.</summary>
    [Parameter] public string Title { get; set; } = "Search indexing";

    /// <summary>Origin offered as the canonical URL while no settings are saved yet.</summary>
    [Parameter] public string? SuggestedCanonicalUrl { get; set; }

    private bool _expanded;

    private void Toggle() => _expanded = !_expanded;
}
