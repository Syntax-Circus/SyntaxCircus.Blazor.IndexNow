<div class="mt-3" aria-busy="@(_busy ? "true" : "false")">
    @if (_busy)
    {
        <p class="small text-body-secondary" role="status">Working on the IndexNow request...</p>
    }
    @if (_message is not null)
    {
        <p class="alert alert-success" role="status" id="indexnow-message">@_message</p>
    }
    @if (_problem is not null)
    {
        <div class="alert alert-danger" role="alert" id="indexnow-error">
            <p class="mb-0">@_problem</p>
        </div>
    }
    @if (_settings is not null)
    {
        <fieldset disabled="@_busy">
            <legend class="h6">IndexNow settings</legend>
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label class="form-label" for="indexnow-site">Canonical HTTPS origin</label>
                    <input type="url" class="form-control" id="indexnow-site" placeholder="https://example.com"
                           @bind="_canonicalUrl" @bind:event="oninput" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="indexnow-sitemap">Sitemap path</label>
                    <input class="form-control" id="indexnow-sitemap" @bind="_sitemapPath" @bind:event="oninput" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label" for="indexnow-key-path">Ownership file path</label>
                    <input class="form-control" id="indexnow-key-path" @bind="_keyFilePath" @bind:event="oninput" />
                </div>
            </div>
            <div class="form-check mt-3">
                <input type="checkbox" class="form-check-input" id="indexnow-enabled" @bind="_enableIndexNow" />
                <label class="form-check-label" for="indexnow-enabled">Enable IndexNow submissions</label>
            </div>
        </fieldset>
    }
    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (_settings is not null)
        {
            <button type="button" class="btn btn-primary btn-sm" id="indexnow-save" disabled="@(!CanSave)" @onclick="SaveSettingsAsync">Save IndexNow settings</button>
        }
        <button type="button" class="btn btn-outline-secondary btn-sm" id="indexnow-reload" disabled="@_busy" @onclick="ReloadSettingsAsync">Reload settings</button>
    </div>
    @if (_settings is not null)
    {
        <div class="mt-4">
            <h3 class="h6">Ownership file and sitemap</h3>
            <p class="small text-body-secondary">
                Reuse the existing ownership file, or generate and download one for a one-time deployment.
                Serve the file as public plain text
                @if (OwnershipFileUrl is { } ownershipFileUrl)
                {
                    <text>at <code class="text-break">@ownershipFileUrl</code></text>
                }
                else
                {
                    <text>at the saved ownership file path</text>
                }.
            </p>
            @if (HasChanges)
            {
                <p class="small text-body-secondary">Save the settings to check the new configuration.</p>
            }
            else if (!IsConfigured)
            {
                <p class="small text-body-secondary">Save a canonical HTTPS origin to set up IndexNow.</p>
            }
            @if (!_settings.IsEnabled)
            {
                <p class="small text-body-secondary">Enable IndexNow to submit URLs. You can still check the setup.</p>
            }
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="indexnow-generate"
                        disabled="@(!CanCheckSetup)" @onclick="GenerateKeyFileAsync">Generate ownership file</button>
                @if (!HasChanges && _keyFile is { } file)
                {
                    <a class="btn btn-outline-primary btn-sm" id="indexnow-key-download" href="@KeyFileDownloadUrl" download="@file.FileName">Download @file.FileName</a>
                }
                <button type="button" class="btn btn-outline-primary btn-sm" id="indexnow-check"
                        disabled="@(!CanCheckSetup)" @onclick="PreviewAsync">Check setup and preview URLs</button>
            </div>
        </div>
    }
    @if (_preview is { } preview && !HasChanges)
    {
        <div class="mt-4" id="indexnow-preview">
            <h3 class="h6">Sitemap preview</h3>
            <p class="small text-body-secondary">The public ownership file and sitemap are reachable. Found @preview.Urls.Count URLs.</p>
            <ul class="list-unstyled border rounded p-2 overflow-auto" style="max-height: 20rem;">
                @foreach (var url in preview.Urls.Skip(_previewPage * PreviewPageSize).Take(PreviewPageSize))
                {
                    <li @key="url">
                        <label class="d-flex align-items-start gap-2 p-1">
                            <input type="checkbox" class="form-check-input flex-shrink-0" checked="@_selectedUrls.Contains(url)"
                                   disabled="@(!CanSubmit)" @onchange="args => SetSelected(url, args.Value is true)" />
                            <span class="small text-break">@url</span>
                        </label>
                    </li>
                }
            </ul>
            @if (PreviewPageCount > 1)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="indexnow-previous-page"
                            disabled="@(_busy || _previewPage == 0)" @onclick="() => MovePreviewPage(-1)">Previous URLs</button>
                    <span class="small text-body-secondary" role="status">Page @(_previewPage + 1) of @PreviewPageCount</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="indexnow-next-page"
                            disabled="@(_busy || _previewPage == PreviewPageCount - 1)" @onclick="() => MovePreviewPage(1)">Next URLs</button>
                </div>
            }
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" id="indexnow-submit-selected"
                        disabled="@(!CanSubmit || _selectedUrls.Count == 0)" @onclick="SubmitSelectedAsync">Submit selected (@_selectedUrls.Count)</button>
                <button type="button" class="btn btn-outline-primary btn-sm" id="indexnow-submit-all"
                        disabled="@(!CanSubmit || preview.Urls.Count == 0)" @onclick="SubmitAllAsync">Submit all (@preview.Urls.Count)</button>
            </div>
        </div>
    }
    @if (_lastSubmission is { } lastSubmission)
    {
        <div class="alert alert-info mt-3" role="status" id="indexnow-result">
            <strong>@StatusLabel(lastSubmission.Status, lastSubmission.CreatedAt)</strong>
            <span> | @lastSubmission.UrlCount URLs</span>
            <div class="small">Search engines determine whether pages appear in search results.</div>
            @if (!string.IsNullOrWhiteSpace(lastSubmission.Error))
            {
                <div>@lastSubmission.Error</div>
            }
        </div>
    }
    <div class="mt-4" id="indexnow-history">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h3 class="h6 mb-0">IndexNow submission history</h3>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="indexnow-refresh-history" disabled="@_busy"
                    @onclick="RefreshHistoryAsync">Refresh history</button>
        </div>
        @if (_historyProblem is not null)
        {
            <p class="alert alert-warning" role="alert" id="indexnow-history-error">@_historyProblem</p>
        }
        @if (_history is { Count: 0 })
        {
            <p class="small text-body-secondary mb-0">No IndexNow submissions yet.</p>
        }
        @if (_history is { Count: > 0 } history)
        {
            <ul class="list-group">
                @foreach (var item in history)
                {
                    <li @key="item.Id" class="list-group-item">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div class="text-break">
                                <strong>@StatusLabel(item.Status, item.CreatedAt)</strong>
                                <span class="small"> | @item.UrlCount URLs | @item.Trigger</span>
                                <div class="small text-body-secondary">@item.CreatedAt.ToLocalTime().ToString("g") by @ActorName(item)</div>
                                @if (!string.IsNullOrWhiteSpace(item.Error))
                                {
                                    <div class="small">@item.Error</div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="@($"indexnow-details-{item.Id}")"
                                        aria-expanded="@(_openHistoryItem == item.Id ? "true" : "false")" disabled="@_busy" @onclick="() => ToggleDetailsAsync(item.Id)">
                                    @(_openHistoryItem == item.Id ? "Hide details" : "View details")
                                </button>
                                @if (CanRetryStatus(item))
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" id="@($"indexnow-retry-{item.Id}")"
                                            data-retry disabled="@(!CanRetry(item))" @onclick="() => RetryAsync(item)">
                                        @(IsInterrupted(item.Status, item.CreatedAt) ? "Retry unconfirmed URLs" : "Retry failed URLs")
                                    </button>
                                }
                            </div>
                        </div>
                        @if (_openHistoryItem == item.Id)
                        {
                            <div class="small mt-2 overflow-auto" id="@($"indexnow-batches-{item.Id}")" style="max-height: 20rem;">
                                @if (_historyDetailProblem is not null)
                                {
                                    <p class="alert alert-warning mb-0" role="alert">@_historyDetailProblem</p>
                                }
                                else if (_historyDetails is { } details)
                                {
                                    <a class="btn btn-outline-secondary btn-sm mb-2" href="@_historyDownloadUrl"
                                       download="@($"indexnow-submission-{details.Id}.json")">Download full submission JSON</a>
                                    @if (details.Batches.Count == 0)
                                    {
                                        <p class="mb-1">No batch results recorded.</p>
                                    }
                                    @foreach (var batch in details.Batches)
                                    {
                                        <div class="mb-2">
                                            <strong>@(batch.StatusCode is { } code ? $"HTTP {code}" : "No HTTP status")</strong>
                                            @if (!string.IsNullOrWhiteSpace(batch.Error))
                                            {
                                                <span> | @batch.Error</span>
                                            }
                                            <p class="mb-1 text-body-secondary">Showing @Math.Min(HistoryBatchUrlLimit, batch.Urls.Count) of @batch.Urls.Count URLs</p>
                                            <ul class="mb-0 text-break">
                                                @foreach (var url in batch.Urls.Take(HistoryBatchUrlLimit))
                                                {
                                                    <li>@url</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="mb-1" role="status">Loading submission details...</p>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
